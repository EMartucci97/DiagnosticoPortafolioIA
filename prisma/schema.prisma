generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Diagnostico {
  id           Int      @id @default(autoincrement())
  created_at   DateTime @default(now())
  email        String?
  portfolio    String?
  quiz_answers String?
  diagnostico  String?
  nota_interna String?
  score        Int?

  @@map("diagnosticos")
}
